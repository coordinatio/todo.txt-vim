" function todo#TagValue(line, tag), todo#ParsePeriod(period), todo#IsStub(line) {{{2
Before:
After:
Given:
Execute (Read the service tags of a stub):
  AssertEqual '1m', todo#TagValue('(P) Pay every:1m last:2026-09-01 rid:a1b2', 'every')
  AssertEqual '2026-09-01', todo#TagValue('(P) Pay every:1m last:2026-09-01 rid:a1b2', 'last')
  AssertEqual 'a1b2', todo#TagValue('(P) Pay every:1m last:2026-09-01 rid:a1b2', 'rid')
  AssertEqual 'a1b2', todo#TagValue('(B) Pay the internet +home rid:a1b2', 'rid')
  " A tag is a whole word, a missing tag is empty
  AssertEqual '', todo#TagValue('(P) Pay notevery:1m', 'every')
  AssertEqual '', todo#TagValue('(P) Pay every:1m', 'last')
Execute (todo#ParsePeriod takes the units of the date arithmetic):
  AssertEqual [2, 'w'], todo#ParsePeriod('2w')
  AssertEqual [10, 'd'], todo#ParsePeriod('10d')
  AssertEqual [1, 'm'], todo#ParsePeriod('1m')
  AssertEqual [1, 'y'], todo#ParsePeriod('1Y')
  AssertEqual [], todo#ParsePeriod('')
  AssertEqual [], todo#ParsePeriod('0d')
  AssertEqual [], todo#ParsePeriod('w')
  AssertEqual [], todo#ParsePeriod('1h')
Execute (todo#IsStub knows the (P) role):
  Assert todo#IsStub('(P) Pay the internet +home every:1m rid:a1b2')
  Assert todo#IsStub('2026-09-01 (P) Book a dentist show:2026-10-14')
  Assert !todo#IsStub('(B) Pay the internet +home rid:a1b2')
  Assert !todo#IsStub('(P)ay the internet')
  " A completed line stays completed, whatever its priority
  Assert !todo#IsStub('x 2026-09-30 Pay the internet pri:P')

" function todo#MakeStub(line, tags) {{{2
Before:
After:
Given:
Execute (A stub is the wording of the task, without its role):
  AssertEqual '(P) Pay the internet +home every:1m rid:a1b2',
    \ todo#MakeStub('2026-09-01 (B) Pay the internet +home', ['every:1m', 'rid:a1b2'])
  AssertEqual '(P) Pay the internet +home @phone every:1m rid:a1b2',
    \ todo#MakeStub('(B) 2026-09-01 Pay the internet +home @phone', ['every:1m', 'rid:a1b2'])
  " active:1 belongs to one concrete line, an ordinary tag travels
  AssertEqual '(P) Book a dentist +health due:2026-10-01 show:2026-10-14',
    \ todo#MakeStub('(A) Book a dentist +health active:1 due:2026-10-01', ['show:2026-10-14'])
  AssertEqual '(P) Pay the internet +home every:2w rid:a1b2',
    \ todo#MakeStub('(P) Pay the internet +home every:1m last:2026-09-01 rid:a1b2', ['every:2w', 'rid:a1b2'])

" function todo#MakeTask(stub, date) {{{2
Before:
After:
Given:
Execute (An instance is the stub as a (B) task created today):
  AssertEqual '(B) 2026-09-30 Pay the internet +home rid:a1b2',
    \ todo#MakeTask('(P) Pay the internet +home every:1m last:2026-09-01 rid:a1b2', '2026-09-30')
  " A one-shot stub has no rid:, so the instance has none either
  AssertEqual '(B) 2026-10-14 Book a dentist +health',
    \ todo#MakeTask('(P) Book a dentist +health show:2026-10-14', '2026-10-14')
  " A due: that is already today or later is left alone
  AssertEqual '(B) 2026-09-30 Pay the internet +home @phone due:2026-10-05 rid:a1b2',
    \ todo#MakeTask('(P) Pay the internet +home @phone due:2026-10-05 every:1m rid:a1b2', '2026-09-30')
  AssertEqual '(B) 2026-09-30 Pay the internet due:2026-09-30 rid:a1b2',
    \ todo#MakeTask('(P) Pay the internet due:2026-09-30 every:1m rid:a1b2', '2026-09-30')
Execute (A repeating stub rolls a past due: forward):
  " 2021-03-05 plus 67 months is the first due date not before 2026-10-01:
  " an instance is never born overdue, the way a verbatim copy would be
  AssertEqual '(B) 2026-10-01 Water the flowers +garden due:2026-10-05 rid:b2c3',
    \ todo#MakeTask('(P) Water the flowers +garden due:2021-03-05 every:1m rid:b2c3', '2026-10-01')
  " The period, not the calendar, moves the date
  AssertEqual '(B) 2026-10-01 Water the flowers due:2026-10-04 rid:b2c3',
    \ todo#MakeTask('(P) Water the flowers due:2026-09-20 every:2w rid:b2c3', '2026-10-01')
Execute (A one-shot stub keeps the due: the user wrote):
  " No period to roll by: both dates were set knowingly, and seeing that the
  " task is overdue is useful
  AssertEqual '(B) 2026-10-14 Book a dentist +health due:2026-09-01',
    \ todo#MakeTask('(P) Book a dentist +health due:2026-09-01 show:2026-10-14', '2026-10-14')
Execute (An absurdly stale due: is dropped, not kept overdue):
  " 2000-01-01 daily is past the rolling cap: a due: thousands of periods
  " stale carries no meaning, and keeping it would undo the whole fix
  AssertEqual '(B) 2026-10-01 Old chore rid:a1b2',
    \ todo#MakeTask('(P) Old chore due:2000-01-01 every:1d rid:a1b2', '2026-10-01')

" function todo#StubDue(stub, today) {{{2
Before:
After:
Given:
Execute (A repeat stub is due once last: plus every: has passed):
  " Without last: the first instance is still open, there is nothing to count from
  Assert !todo#StubDue('(P) Pay the internet every:1m rid:a1b2', '2026-09-30')
  Assert  todo#StubDue('(P) Pay the internet every:1m last:2026-08-30 rid:a1b2', '2026-09-30')
  Assert !todo#StubDue('(P) Pay the internet every:1m last:2026-09-01 rid:a1b2', '2026-09-30')
  " The day the period ends is already due
  Assert  todo#StubDue('(P) Pay the internet every:1m last:2026-09-01 rid:a1b2', '2026-10-01')
  Assert  todo#StubDue('(P) Pay the internet every:2w last:2026-09-01 rid:a1b2', '2026-09-15')
  Assert !todo#StubDue('(P) Pay the internet every:2w last:2026-09-01 rid:a1b2', '2026-09-14')
  Assert  todo#StubDue('(P) Pay the internet every:1y last:2025-09-30 rid:a1b2', '2026-09-30')
  Assert  todo#StubDue('(P) Pay the internet every:10d last:2026-09-20 rid:a1b2', '2026-09-30')
Execute (A one-shot stub is due on its show: day):
  Assert !todo#StubDue('(P) Book a dentist show:2026-10-14', '2026-10-13')
  Assert  todo#StubDue('(P) Book a dentist show:2026-10-14', '2026-10-14')
